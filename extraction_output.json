    {
      "step_id": 8,
      "text": "P(T1|E) = \\frac{\\frac{3}{10} \\cdot \\frac{1}{4}}{\\frac{3}{10} \\cdot \\frac{1}{4} + \\frac{1}{5} \\cdot \\frac{1}{3} + \\frac{1}{10} \\cdot \\frac{1}{12} + \\frac{2}{5} \\cdot 0}",
